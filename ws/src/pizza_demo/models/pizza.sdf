<?xml version="1.0"?>
<!-- ピザ：直径 30 cm、厚さ 1.2 cm、質量 0.4 kg の円柱 -->
<sdf version="1.9">
  <model name="pizza">
    <static>false</static>
    <link name="pizza_link">
      <inertial>
        <mass>0.4</mass>
        <!-- 中実円柱: ixx = iyy = m(3r^2 + h^2)/12, izz = m r^2 / 2 -->
        <inertia>
          <ixx>0.002255</ixx>
          <iyy>0.002255</iyy>
          <izz>0.0045</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.012</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- 生地（耳が見えるよう、チーズより一回り大きい） -->
      <visual name="crust">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.012</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.35 0.15 1</ambient>
          <diffuse>0.75 0.50 0.22 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <!-- チーズ（生地の上面に薄く重ねる） -->
      <visual name="cheese">
        <pose>0 0 0.007 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.135</radius>
            <length>0.002</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.75 0.60 0.15 1</ambient>
          <diffuse>0.98 0.82 0.25 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- プチトマト（回転がわかる目印。中心から 8 cm ずらし、下半分はチーズに埋める。見た目のみ） -->
      <visual name="tomato">
        <pose>0.08 0 0.008 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.012</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.6 0.05 0.05 1</ambient>
          <diffuse>0.9 0.1 0.1 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
