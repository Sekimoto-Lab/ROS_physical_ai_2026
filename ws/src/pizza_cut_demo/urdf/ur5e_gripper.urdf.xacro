<?xml version="1.0"?>
<!-- Gazebo 用の UR5e に Robotiq 2F-85 の見た目を付けたもの。
     指は動かさず、少し閉じた形で固定する（見た目のみ・当たり判定なし）。
     板は DetachableJoint で手首に固定・解除する。 -->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <xacro:arg name="name" default="ur"/>

  <!-- ur_simulation_gz の標準の記述（アーム・床・ros2_control）をそのまま使う -->
  <xacro:include filename="$(find ur_simulation_gz)/urdf/ur_gz.urdf.xacro"/>
  <xacro:include filename="$(find robotiq_description)/urdf/ur_to_robotiq_adapter.urdf.xacro"/>

  <!-- 指の開き（ナックル関節の角度）。0 で全開、0.8 で全閉 -->
  <xacro:property name="q" value="0.45"/>
  <xacro:property name="mesh" value="file://$(find robotiq_description)/meshes/visual"/>

  <!-- 見た目だけのリンク（質量は小さく、当たり判定なし） -->
  <xacro:macro name="gripper_part" params="name parent xyz pitch">
    <link name="${name}_link">
      <visual>
        <geometry><mesh filename="${mesh}/${name}.dae"/></geometry>
      </visual>
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="0 ${pitch} 0"/>
    </joint>
  </xacro:macro>

  <!-- tool0 → 変換プレート → グリッパー本体 -->
  <xacro:ur_to_robotiq prefix="" connected_to="tool0"/>
  <xacro:gripper_part name="robotiq_base" parent="gripper_mount_link" xyz="0 0 0" pitch="0"/>

  <!-- 位置は robotiq_description の関節の原点。どの関節も回転軸が -y なので、角度 a は pitch = -a で表す
       （右側は mimic の倍率 -1 で角度の符号が逆になる） -->
  <xacro:gripper_part name="left_knuckle" parent="robotiq_base_link" xyz="0.03060114 0 0.05490452" pitch="${-q}"/>
  <xacro:gripper_part name="right_knuckle" parent="robotiq_base_link" xyz="-0.03060114 0 0.05490452" pitch="${q}"/>
  <xacro:gripper_part name="left_finger" parent="left_knuckle_link" xyz="0.03152616 0 -0.00376347" pitch="0"/>
  <xacro:gripper_part name="right_finger" parent="right_knuckle_link" xyz="-0.03152616 0 -0.00376347" pitch="0"/>
  <xacro:gripper_part name="left_inner_knuckle" parent="robotiq_base_link" xyz="0.0127 0 0.06142" pitch="${-q}"/>
  <xacro:gripper_part name="right_inner_knuckle" parent="robotiq_base_link" xyz="-0.0127 0 0.06142" pitch="${q}"/>
  <xacro:gripper_part name="left_finger_tip" parent="left_finger_link" xyz="0.00563134 0 0.04718515" pitch="${q}"/>
  <xacro:gripper_part name="right_finger_tip" parent="right_finger_link" xyz="-0.00563134 0 0.04718515" pitch="${-q}"/>

  <!-- 板（モデル名 board）を手首に固定・解除する。固定ジョイントでつながった tool0 やグリッパーは
       Gazebo への変換で wrist_3_link にまとめられるので、親リンクは wrist_3_link にする。
       板が現れると自動で固定されるので、起動ファイルで出した直後に一度解除している。 -->
  <gazebo>
    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>wrist_3_link</parent_link>
      <child_model>board</child_model>
      <child_link>board_link</child_link>
      <attach_topic>/board/attach</attach_topic>
      <detach_topic>/board/detach</detach_topic>
      <output_topic>/board/state</output_topic>
      <suppress_child_warning>true</suppress_child_warning>
    </plugin>
  </gazebo>
</robot>
